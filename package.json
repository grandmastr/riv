{
  "name": "riv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @riv/api exec drizzle-kit generate --config=../../drizzle.config.ts",
    "db:push": "pnpm --filter @riv/api exec drizzle-kit push --config=../../drizzle.config.ts",
    "db:studio": "pnpm --filter @riv/api exec drizzle-kit studio --config=../../drizzle.config.ts",
    "dev": "pnpm --parallel --filter @riv/api --filter @riv/extension dev",
    "dev:api": "pnpm --filter @riv/api dev",
    "dev:extension": "pnpm --filter @riv/extension dev",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm --filter @riv/contracts test && pnpm --filter @riv/agent test && pnpm --filter @riv/api test && pnpm --filter @riv/extension test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
