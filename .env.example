PORT=8787
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:8787
# Runtime pooler URL for IPv4/serverless style access.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Optional: preferred for long-running API servers if your environment supports IPv6.
DATABASE_DIRECT_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres
# Optional: preferred for Drizzle schema push/migrations; falls back to DATABASE_DIRECT_URL, then DATABASE_URL.
DATABASE_MIGRATION_URL=
OPENAI_API_KEY=sk-your-openai-key
RIV_DEV_USER_ID=user_dev
